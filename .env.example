VITE_OTRI_API_BASE_URL=http://localhost:8000

# --- api/ (FastAPI backend) ---
# These are read by api/app.py, api/auth.py, api/db.py, api/email.py — export
# them in your shell (or a process manager) before running uvicorn/gunicorn.
# Not auto-loaded from this file (no python-dotenv dependency), unlike the
# VITE_* vars above which Vite loads automatically.
DATABASE_URL=postgresql://postgres:otri_dev_password@localhost:5432/otri
OTRI_API_JWT_SECRET=
RESEND_API_KEY=
OTRI_EMAIL_FROM=OTRI <noreply@otri.run>
OTRI_APP_BASE_URL=http://localhost:5173
OTRI_API_ALLOWED_ORIGINS=http://localhost:5173


# Optional pinned local DEM correction; install course/requirements-terrain.txt first.
# OTRI_DEM_MANIFEST=/srv/otri/terrain/manifest.json

# Disk budget for GPX files stored by the calculator's "Share this score" (gzip on disk,
# oldest evicted first when full). Default 2048 MB.
# OTRI_SHARED_COURSES_MAX_MB=2048

# Organizer accounts that get admin rights (see every event, unpublish any race). The flag is
# applied at sign-in and removed on the next sign-in after the email is taken off this list.
# OTRI_ADMIN_EMAILS=you@example.com

# Optional: error monitoring. Leave empty to disable. Only exceptions are sent, never request bodies or personal data.
SENTRY_DSN=
