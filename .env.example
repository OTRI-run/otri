VITE_OTRI_API_BASE_URL=http://localhost:8000

# --- api/ (FastAPI backend) ---
# These are read by api/app.py, api/auth.py, api/db.py, api/email.py — export
# them in your shell (or a process manager) before running uvicorn/gunicorn.
# Not auto-loaded from this file (no python-dotenv dependency), unlike the
# VITE_* vars above which Vite loads automatically.
DATABASE_URL=postgresql://postgres:otri_dev_password@localhost:5432/otri
OTRI_API_JWT_SECRET=
RESEND_API_KEY=
OTRI_EMAIL_FROM=OTRI <noreply@otri.run>
OTRI_APP_BASE_URL=http://localhost:5173
OTRI_API_ALLOWED_ORIGINS=http://localhost:5173
# This API's own public address: where Google is told to send the browser back, and where a
# link we email points. It has to match the redirect URI registered in the Google console.
# Set it in production. Left empty the address is read from the request, which is right for a
# local run and wrong behind a proxy: nginx passes X-Forwarded-Host through from whoever sent it.
OTRI_API_BASE_URL=
# Optional: "Continue with Google" for organizer accounts (api/oauth_google.py). Create an OAuth
# client of type "Web application" in the Google Cloud console and add the API's callback as an
# authorised redirect URI, exactly:
#   https://api.otri.run/auth/google/callback      (production)
#   http://localhost:8000/auth/google/callback     (development)
# The site itself needs nothing: the API runs the whole flow. With either value empty the buttons
# do not appear and the routes answer 404.
# OTRI_GOOGLE_CLIENT_ID=
# OTRI_GOOGLE_CLIENT_SECRET=


# Optional pinned local DEM correction; install course/requirements-terrain.txt first.
# OTRI_DEM_MANIFEST=/srv/otri/terrain/manifest.json

# Disk budget for GPX files stored by the calculator's "Share this score" (gzip on disk,
# oldest evicted first when full). Default 2048 MB.
# OTRI_SHARED_COURSES_MAX_MB=2048

# Organizer accounts that get admin rights (see every event, unpublish any race). The flag is
# applied at sign-in and removed on the next sign-in after the email is taken off this list.
# OTRI_ADMIN_EMAILS=you@example.com

# Optional: the site's race and runner pages are built from the API by GitHub Pages. With a
# fine-grained GitHub token (Contents: read and write on the repository) the API asks GitHub for
# a build whenever a race is published, unpublished or listed; without one the daily schedule
# in .github/workflows/pages.yml catches up.
# OTRI_GITHUB_DISPATCH_TOKEN=
# OTRI_GITHUB_REPO=OTRI-run/otri

# Optional: error monitoring. Leave empty to disable. Only exceptions are sent, never request bodies or personal data.
SENTRY_DSN=
