dist/
node_modules/
.env
__pycache__/
*.pyc
.pytest_cache/
*.db

# Local-only deploy helper (contains this machine's SSH key path/droplet address) — never push.
redeploy.ps1
redeploy.bat

# Real organizer course files used for local scoring/calibration work. DATA_POLICY.md treats
# third-party GPX as restricted (typically copyrighted, participant-use only), so these stay
# local and are never pushed. The synthetic sample course is committed and stays tracked.
# Tests that measure real courses skip cleanly when these are absent
# (tests/unit/test_scoring_terrain.py).
data/demo/gpx/*.gpx
!data/demo/gpx/sample-course.gpx

# Measurement cache written by the API (see api/app.py); content-addressed, safe to delete.
data/cache/

# Course files collected for race listings, with the CSVs imported alongside them. Third-party GPX
# stays local (DATA_POLICY.md); a file reaches OTRI only through the admin upload, with its permission.
gpx courses/

# Race calendars and results collected from third-party sources, kept to pick listings from. Local
# only (DATA_POLICY.md: facts are re-compiled into a listings CSV, the source files are not published).
docs/race result data/
